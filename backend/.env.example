PROJECT_NAME="Expensio API"
# Local SQLite (for local testing):
# DATABASE_URL="sqlite:///./expenses.db"

# Production PostgreSQL (Neon / Supabase / Render Postgres):
# Neon connection string example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key (generate a random 32+ char key, e.g. run: openssl rand -hex 32)
SECRET_KEY="generate-a-strong-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins (your Vercel app URL)
ALLOWED_ORIGINS="http://localhost:5173,https://your-expensio-frontend.vercel.app"
